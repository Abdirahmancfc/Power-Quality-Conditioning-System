.gitignore

% MATLAB Files
*.m~
*.asv
*.mex*
*.slxc
*.slx~

% Simulink cache
slprj/
sfprj/
*.log

% Simulink model cache
ModelAdvisor/

% MATLAB autosave
*_autosave.m

% System files
.DS_Store
Thumbs.db

% Temporary files
*.tmp
*.bak
*.backup

% IDE files
.vscode/
.idea/
*.swp
*.swo

% Python cache
__pycache__/
*.pyc

% Large data files (optional - uncomment if needed)
# *.mat
# *.dat
# *.bin

% Build artifacts
build/
dist/
*.o
*.a
*.so

% Documentation
# *.pdf (keep PDFs generated)

% Cache and temp
*.cache
.cache/
